[Unit]
Description=B7 HTTPS certificate renewal and proxy reload
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/B7-1
ExecStart=/usr/bin/flock --nonblock /run/lock/b7-tls-renew.lock /usr/bin/python3 -m scripts.manage_tls renew
UMask=0077
TimeoutStartSec=30min
