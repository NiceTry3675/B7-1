server_tokens off;
log_format safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                '$status $body_bytes_sent request_time=$request_time';

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Re-resolve Compose service addresses after backend/frontend containers are recreated.
resolver 127.0.0.11 valid=10s ipv6=off;
upstream backend_service {
    zone backend_service 64k;
    server backend:8000 resolve;
}
upstream frontend_service {
    zone frontend_service 64k;
    server frontend:7860 resolve;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${SITE_ADDRESS};
    access_log /var/log/nginx/access.log safe;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 308 https://${SITE_ADDRESS}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SITE_ADDRESS};
    access_log /var/log/nginx/access.log safe;
    ssl_certificate /etc/letsencrypt/live/${SITE_ADDRESS}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE_ADDRESS}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    proxy_hide_header X-Content-Type-Options;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_read_timeout ${PROXY_TIMEOUT_SECONDS}s;
    proxy_send_timeout ${PROXY_TIMEOUT_SECONDS}s;
    proxy_next_upstream off;
    proxy_buffering off;
    proxy_cache off;

    location ~ ^/(api/v1(/|$)|docs(/|$)|openapi\.json$|redoc$) {
        proxy_pass http://backend_service;
    }
    location / {
        proxy_pass http://frontend_service;
    }
}
