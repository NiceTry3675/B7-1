server_tokens off;

server {
    listen 80;
    listen [::]:80;
    server_name ${SITE_ADDRESS};
    access_log off;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        default_type text/plain;
        return 503 "HTTPS certificate setup is pending.\n";
    }
}
