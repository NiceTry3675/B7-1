{$SITE_ADDRESS:localhost} {
    encode zstd gzip
    @backend path /api/v1/* /docs /docs/* /openapi.json /redoc
    handle @backend {
        reverse_proxy backend:8000 {
            transport http {
                dial_timeout 5s
                response_header_timeout {$PROXY_TIMEOUT_SECONDS:180}s
                read_timeout {$PROXY_TIMEOUT_SECONDS:180}s
                write_timeout {$PROXY_TIMEOUT_SECONDS:180}s
            }
        }
    }
    handle {
        reverse_proxy frontend:7860 {
            flush_interval -1
            transport http {
                dial_timeout 5s
                response_header_timeout {$PROXY_TIMEOUT_SECONDS:180}s
                read_timeout {$PROXY_TIMEOUT_SECONDS:180}s
                write_timeout {$PROXY_TIMEOUT_SECONDS:180}s
            }
        }
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        Strict-Transport-Security "max-age=31536000"
    }
}
