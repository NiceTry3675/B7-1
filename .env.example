# Copy to .env. Blank LLM settings intentionally return AI_CONFIG_ERROR on questions.
DATABASE_URL=sqlite:///./data/chat.db
SESSION_TTL_SECONDS=43200
BACKEND_BASE_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT_SECONDS=160
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
LOG_LEVEL=INFO

LLM_BASE_URL=
LLM_SERVICE_TOKEN=
LLM_MODEL=local-advisor
# Local tokenizer files only; same tokenizer AND chat template as the remote wrapper.
LLM_TOKENIZER_PATH=
LLM_CONTEXT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=256
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_GENERATION_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS=130
TURN_TIMEOUT_SECONDS=145
PROXY_TIMEOUT_SECONDS=180
TURN_STALE_SECONDS=210

# Production Docker Compose only; set your actual DNS name before deploying.
SITE_ADDRESS=localhost
# Host directory containing tokenizer files (no model weights needed here).
TOKENIZER_HOST_PATH=./models/tokenizer
